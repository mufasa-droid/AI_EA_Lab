{
  "project": {
    "name": "AI-EA-Lab",
    "version": "1.0.0",
    "purpose": "Automated quantitative research and backtesting laboratory for MetaTrader 5 Expert Advisors",
    "nature": "Strictly offline research and backtesting environment. No live trading, broker account balance risking, or autonomous unconstrained parameter sweeps.",
    "approval_boundary": "Explicit human approval required for candidate code changes and backtest execution."
  },
  "repository": {
    "active_branch": "main",
    "git_status": "3 commits ahead of origin/main (d5db6b8, 7f2a2a0, 69d85f0)",
    "working_tree": "Modified ea/Fibonacci_EA_v5_0.mq5, ea/Fibonacci_EA_v5_0.ex5; untracked candidate records, presets, and recent experiment runs",
    "total_experiments": 44,
    "total_audits": 45
  },
  "architecture": {
    "pipeline": [
      {
        "component": "AI Researcher",
        "script": "scripts/researcher.py",
        "role": "Formulates testable hypotheses from observed empirical facts.",
        "input": "Historical experiments and memory",
        "output": "research/hypotheses/HYP-XXXX.json"
      },
      {
        "component": "Experiment Planner",
        "script": "scripts/researcher.py",
        "role": "Designs controlled experiments isolating one primary independent variable against a verified baseline.",
        "input": "HYP-XXXX.json",
        "output": "research/plans/PLAN-XXXX.json"
      },
      {
        "component": "Human Approval Boundary",
        "script": "scripts/developer.py --approve",
        "role": "Enforces human review and cryptographically verified approval record before any code modification.",
        "status": "Mandatory"
      },
      {
        "component": "AI Developer",
        "script": "scripts/developer.py",
        "role": "Creates candidate workspaces, confines modifications strictly to authorized inputs, and compiles via MetaEditor.",
        "input": "Approved PLAN-XXXX.json",
        "output": "developer/candidates/CAND-XXXX/"
      },
      {
        "component": "AI Backtest Runner",
        "script": "scripts/run_candidate.py",
        "role": "Stages candidate binaries, resolves dataset partitions, executes headless MT5 Strategy Tester, and extracts verified UTF-16 HTML reports.",
        "input": "Verified CAND-XXXX",
        "output": "experiments/EXP-XXXX/"
      },
      {
        "component": "AI Auditor",
        "script": "scripts/auditor.py",
        "role": "Independent post-run verification of artifact hashes, unbroken provenance lineage, execution validity, and plan compliance.",
        "input": "EXP-XXXX",
        "output": "audits/AUD-XXXX.json"
      },
      {
        "component": "Research Memory",
        "script": "scripts/memory.py",
        "role": "Indexes experiment outcomes, synthesizes empirical findings, and maintains cumulative research catalog.",
        "output": "research/memory/indexes/index.json"
      },
      {
        "component": "Research Orchestrator",
        "script": "scripts/orchestrator.py",
        "role": "Sequences end-to-end multi-phase research iterations with bounded iteration guards.",
        "safety": "Halts at human approval boundary"
      }
    ]
  },
