InpMaxSwingPips=500.0
InpMinBarsAfterSwing=2

; --- FIBONACCI LEVELS ---
InpUseFib236=false
InpUseFib382=true
InpUseFib500=true
InpUseFib618=true
InpUseFib786=false
InpFibBuffer=5.0

; --- FIXED PIP SL/TP ---
InpMaxSLPips=15.0
InpTP1Pips=15.0
InpTP2Pips=30.0
InpTP1ClosePct=50.0
InpTrailPips=8.0

; --- ENTRY FILTERS ---
InpUseTrend=true
InpTrendEma=50
InpUseSession=true
InpLondonOpen=8
InpLondonClose=12
InpNYOpen=13
InpNYClose=17
InpUseAsianSession=false
InpAsianOpen=0
InpAsianClose=8
